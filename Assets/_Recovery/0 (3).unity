    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 621204247}
    m_FontSize: 22
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "<color=#FFD700><b>[ \uD50C\uB808\uC774\uC5B4 1 (WASD + J/K/L) ]</b></color>\n<size=26>\uC774\uB3D9:
    WASD\n\uC0C1\uB2E8\uAC00\uB4DC: Space+Q (\uD640\uB4DC)  |  \uD558\uB2E8\uAC00\uB4DC:
    C+Q (\uD640\uB4DC)  |  \uC911\uB2E8\uAC00\uB4DC: Q\n\uD68C\uD53C: Left Shift
    (\uC774\uB3D9 \uBC29\uD5A5)\n\uC0C1\uB2E8\uC7BD: Space+J   \uC0C1\uB2E8\uD6C5:
    Space+K\n\uD558\uB2E8\uC7BD: C+J   \uD558\uB2E8\uD6C5: C+K\n\uC911\uB2E8\uC7BD:
    J   \uC911\uB2E8\uD6C5: K   \uC5B4\uD37C\uCEF7: L</size>\n\n<color=#FF8888><b>[
    \uD50C\uB808\uC774\uC5B4 2 (\uBC29\uD5A5\uD0A4 + \uB118\uD328\uB4DC) ]</b></color>\n<size=26>\uC774\uB3D9:
    \u2191\u2193\u2190\u2192\n\uAC00\uB4DC: NumPad 0 (\uD640\uB4DC)  |  \uAC00\uB4DC
    \uC911 \u2191/\u2193 \u2192 \uC0C1\uB2E8/\uD558\uB2E8 \uAC00\uB4DC\n\uD68C\uD53C:
    Right Shift (\uC774\uB3D9 \uBC29\uD5A5)\n\uC7BD: Num1   \uD6C5: Num2   \uC5B4\uD37C\uCEF7:
    Num3</size>"
